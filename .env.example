# Public HTTPS origin, with no trailing path
APP_ORIGIN=https://studio.example.com

# OIDC provider and web application credentials
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Generate 32 random bytes as base64 using the command in README.
SESSION_SECRET=
STUDIO_OWNER_EMAIL=
# Comma-separated verified email addresses, optional
STUDIO_ALLOWED_EMAILS=

# Hostinger MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Private S3-compatible bucket. Use S3_REGION=auto for Cloudflare R2.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional separately hosted avatar service
AVATAR_API_URL=
AVATAR_API_TOKEN=
AVATAR_PREVIEW_ORIGIN=
